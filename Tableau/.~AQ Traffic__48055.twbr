      <aliases enabled='yes' />
      <column caption='Device or not' datatype='real' name='[Calculation_1445374032297713665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [device_name]==&apos;NA&apos;&#13;&#10;then 0&#13;&#10;else [average_bc]&#13;&#10;END' />
      </column>
      <column caption='12 hour clock' datatype='real' name='[Calculation_1445374032298332162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if avg([hour]) &gt; 12&#13;&#10;then round(avg([hour])-12,0)&#13;&#10;elseif avg([hour])==0&#13;&#10;then 12&#13;&#10;else round(avg([hour]),0)&#13;&#10;end' />
      </column>
      <column caption='am or pm' datatype='string' name='[Calculation_1445374032298582019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [hour]&lt;12&#13;&#10;then &quot;am&quot;&#13;&#10;elseif [hour]==0&#13;&#10;then &quot;am&quot;&#13;&#10;else &quot;pm&quot;&#13;&#10;END' />
      </column>
      <column caption='Segment marks' datatype='string' name='[Calculation_1519120476565602304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [point_index]= 1&#13;&#10;then [cmp_name]&#13;&#10;END' />
      </column>
